{{ 'purelane-shop.css' | asset_url | stylesheet_tag }}

{%- assign shop_collection = section.settings.collection -%}

<section
  id="PurelaneShop-{{ section.id }}"
  class="pl-shop"
  aria-labelledby="PurelaneShopHeading-{{ section.id }}"
>

  <div class="pl-shop__inner">

    {%- comment -%}
      ============================================================
      HEADER
      ============================================================
      The "Loved by" number is intentionally editable through
      the Shopify Theme Editor rather than being hardcoded.
    {%- endcomment -%}

    <div class="pl-shop__heading">

      {%- if section.settings.eyebrow != blank -%}
        <span class="pl-shop__eyebrow">
          {{ section.settings.eyebrow | escape }}
        </span>
      {%- endif -%}


      {%- if section.settings.loved_by_label != blank
        or section.settings.loved_by_count != blank
        or section.settings.loved_by_suffix != blank
      -%}

        <h2
          id="PurelaneShopHeading-{{ section.id }}"
          class="pl-shop__title"
        >

          {%- if section.settings.loved_by_label != blank -%}
            <span class="pl-shop__title-label">
              {{ section.settings.loved_by_label | escape }}
            </span>
          {%- endif -%}

          {%- if section.settings.loved_by_count != blank -%}
            <span class="pl-shop__title-count">
              {{ section.settings.loved_by_count | escape }}
            </span>
          {%- endif -%}

          {%- if section.settings.loved_by_suffix != blank -%}
            <span class="pl-shop__title-suffix">
              {{ section.settings.loved_by_suffix | escape }}
            </span>
          {%- endif -%}

        </h2>

      {%- elsif section.settings.heading != blank -%}

        <h2
          id="PurelaneShopHeading-{{ section.id }}"
          class="pl-shop__title"
        >
          {{ section.settings.heading | escape }}
        </h2>

      {%- endif -%}


      <div class="pl-shop__divider" aria-hidden="true">

        <span></span>

        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/>
          <path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/>
        </svg>

        <span></span>

      </div>

    </div>


    {%- if shop_collection != blank and shop_collection.products_count > 0 -%}

      <div class="pl-shop__grid">

        {%- for product in shop_collection.products limit: section.settings.products_to_show -%}

          {%- assign rating = product.metafields.custom.rating.value -%}
          {%- assign review_count = product.metafields.custom.review_count.value -%}

          {%- assign has_compare_price = false -%}
          {%- assign discount_percentage = 0 -%}
          {%- assign savings_amount = 0 -%}


          {%- if product.compare_at_price > product.price -%}

            {%- assign has_compare_price = true -%}

            {%- assign savings_amount =
              product.compare_at_price
              | minus: product.price
            -%}

            {%- assign discount_percentage =
              savings_amount
              | times: 100.0
              | divided_by: product.compare_at_price
              | round
            -%}

          {%- endif -%}


          <article class="pl-shop-card">

            <a
              href="{{ product.url }}"
              class="pl-shop-card__link"
              aria-label="{{ product.title | escape }}"
            >

              {%- comment -%}
                ==================================================
                IMAGE
                ==================================================
              {%- endcomment -%}

              <div class="pl-shop-card__media">

                {%- if product.featured_image != blank -%}

                  {{
                    product.featured_image
                    | image_url: width: 800
                    | image_tag:
                      class: 'pl-shop-card__image',
                      loading: 'lazy',
                      widths: '320, 480, 600, 700, 800',
                      sizes: '(max-width: 600px) 100vw, (max-width: 1000px) 46vw, 270px',
                      alt: product.featured_image.alt | default: product.title
                  }}

                {%- else -%}

                  <div
                    class="pl-shop-card__image-fallback"
                    aria-label="No product image available"
                  >
                    <span>PURELANE</span>
                  </div>

                {%- endif -%}


                {%- comment -%}
                  ==================================================
                  PRODUCT BADGE
                  ==================================================
                {%- endcomment -%}

                {%- if product.tags contains 'best-seller' -%}

                  <span class="pl-shop-card__badge">
                    Best seller
                  </span>

                {%- elsif product.tags contains 'top-rated' -%}

                  <span class="pl-shop-card__badge">
                    Top rated
                  </span>

                {%- elsif product.tags contains 'new' -%}

                  <span class="pl-shop-card__badge">
                    New
                  </span>

                {%- endif -%}


                {%- unless product.available -%}

                  <span class="pl-shop-card__sold-out">
                    Sold out
                  </span>

                {%- endunless -%}

              </div>


              {%- comment -%}
                ==================================================
                CONTENT
                ==================================================
              {%- endcomment -%}

              <div class="pl-shop-card__content">

               <h3
  class="pl-shop-card__product-title"
  title="{{ product.title | escape }}"
  aria-label="{{ product.title | escape }}"
>
  {{ product.title | escape }}
</h3>


                {%- comment -%}
                  ==================================================
                  RATING
                  ==================================================
                  Both metafields are optional.

                  If neither exists, no empty rating row is rendered.
                  If only one exists, only that value appears.
                {%- endcomment -%}

                {%- if rating != blank or review_count != blank -%}

                  <div class="pl-shop-card__rating">

                    {%- if rating != blank -%}

                      <span
                        class="pl-shop-card__rating-value"
                        aria-label="{{ rating }} out of 5 stars"
                      >
                        <span aria-hidden="true">★</span>
                        {{ rating }}
                      </span>

                    {%- endif -%}


                    {%- if rating != blank and review_count != blank -%}

                      <span
                        class="pl-shop-card__rating-separator"
                        aria-hidden="true"
                      >
                        ·
                      </span>

                    {%- endif -%}


                    {%- if review_count != blank -%}

                      <span class="pl-shop-card__review-count">

                        {{ review_count }}
                        review{% if review_count != 1 %}s{% endif %}

                      </span>

                    {%- endif -%}

                  </div>

                {%- endif -%}


                {%- comment -%}
                  ==================================================
                  PRICING
                  ==================================================
                {%- endcomment -%}

                <div class="pl-shop-card__pricing">

                  <span class="pl-shop-card__price">
                    {{ product.price | money_without_trailing_zeros }}
                  </span>


                  {%- if has_compare_price -%}

                    <span class="pl-shop-card__compare">
                      {{ product.compare_at_price | money_without_trailing_zeros }}
                    </span>


                    <span class="pl-shop-card__discount">
                      {{ discount_percentage }}% off
                    </span>

                  {%- endif -%}

                </div>


                {%- comment -%}
                  ==================================================
                  ACTION
                  ==================================================
                {%- endcomment -%}

                {%- if product.available -%}

                  <span class="pl-shop-card__button">

                    <span>
                      {{ section.settings.button_label | escape }}
                    </span>

                    <span
                      class="pl-shop-card__button-arrow"
                      aria-hidden="true"
                    >
                      →
                    </span>

                  </span>

                {%- else -%}

                  <span class="pl-shop-card__button pl-shop-card__button--sold-out">

                    <span>
                      Sold out
                    </span>

                  </span>

                {%- endif -%}

              </div>

            </a>

          </article>

        {%- endfor -%}

      </div>


      {%- if section.settings.show_view_all and shop_collection.url != blank -%}

        <div class="pl-shop__footer">

          <a
            href="{{ shop_collection.url }}"
            class="pl-shop__view-all"
          >

            {{ section.settings.view_all_label | escape }}

            <span aria-hidden="true">→</span>

          </a>

        </div>

      {%- endif -%}


    {%- else -%}

      <div class="pl-shop__empty">

        <p>
          Select the Purelane Products collection in the section settings.
        </p>

      </div>

    {%- endif -%}

  </div>

</section>


{% schema %}

{
  "name": "Purelane shop",

  "tag": "section",

  "class": "section-purelane-shop",

  "settings": [

    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },

    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Bestsellers"
    },

    {
      "type": "text",
      "id": "loved_by_label",
      "label": "Loved by label",
      "default": "Loved by"
    },

    {
      "type": "text",
      "id": "loved_by_count",
      "label": "Loved by count",
      "default": "30,000"
    },

    {
      "type": "text",
      "id": "loved_by_suffix",
      "label": "Loved by suffix",
      "default": "homes"
    },

    {
      "type": "text",
      "id": "heading",
      "label": "Fallback heading",
      "default": "Loved by 30,000 homes"
    },

    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 8,
      "step": 1,
      "default": 8
    },

    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart label",
      "default": "Add to cart"
    },

    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": false
    },

    {
      "type": "text",
      "id": "view_all_label",
      "label": "View all label",
      "default": "Shop all products"
    }

  ],

  "presets": [

    {
      "name": "Purelane shop"
    }

  ]

}

{% endschema %}